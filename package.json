{
  "name": "koter-gym",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "node .next/standalone/server.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:seed": "node --experimental-strip-types scripts/seed.ts",
    "assets:prepare": "node --experimental-strip-types scripts/prepare-assets.ts",
    "verify": "npm run typecheck && npm run lint && npm run build",
    "admin:hash": "node --experimental-strip-types scripts/hash-password.ts",
    "assets:icons": "node --experimental-strip-types scripts/build-icons.ts",
    "assets:textures": "node --experimental-strip-types scripts/build-textures.ts",
    "assets:fonts": "node --experimental-strip-types scripts/build-fonts.ts"
  },
  "dependencies": {
    "better-sqlite3": "^11.7.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "gsap": "^3.12.5",
    "jose": "^5.9.6",
    "next": "^15.1.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.4",
    "tailwind-merge": "^2.5.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.6",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.18.0",
    "eslint-config-next": "^15.1.6",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "engines": {
    "node": ">=20"
  }
}
