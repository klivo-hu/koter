# ---------------------------------------------------------------------------
# KĂ“TER GYM & CROSSFIGHT ARĂ‰NA â€” environment
#
# Copy to .env and fill in. .env is git-ignored and must never be committed.
# In production the app refuses to start if a required value is missing.
# ---------------------------------------------------------------------------

# Public origin â€” used for canonical URLs, the sitemap and Open Graph tags.
# Read on the server at request time, so it can be changed in the hosting panel
# without rebuilding the image.
SITE_URL=https://kotergym.hu

# --- Admin authentication (required) ---------------------------------------

# HS256 signing key for admin sessions. Minimum 32 characters.
# Generate:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# The single admin account.
ADMIN_EMAIL=admin@kotergym.hu

# scrypt hash of the admin password â€” never the password itself.
# Generate:  npm run admin:hash -- "a-vĂˇlasztott-jelszĂł"
# Produces a value shaped like: scrypt.1.<salt>.<hash> â€” dot-separated on purpose,
# because dotenv would expand a $ inside the value and silently truncate it.
ADMIN_PASSWORD_HASH=

# How long a signed-in admin session lasts, in seconds (default 8 hours).
SESSION_TTL_SECONDS=28800

# --- Storage ---------------------------------------------------------------

# Writable directory for the SQLite database and uploaded images.
# Must be a mounted volume in Docker, or uploads are lost on redeploy.
DATA_DIR=/app/data
DATABASE_PATH=/app/data/koter.db
UPLOAD_DIR=/app/data/uploads

# Largest accepted image upload, in bytes (default 8 MB).
MAX_UPLOAD_BYTES=8388608

# --- Hero video (optional) -------------------------------------------------

# Path or URL of the looping hero clip. Leave empty and the hero is the still
# photograph alone. Set it to e.g. /media/hero.mp4 after placing the file in
# public/media/ to turn the moving background on.
NEXT_PUBLIC_HERO_VIDEO=/media/hero.mp4

# --- Runtime ---------------------------------------------------------------

NODE_ENV=production
PORT=80
